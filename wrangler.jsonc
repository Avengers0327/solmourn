// Cloudflare deployment. Deploy command: npx wrangler deploy   (build command: npm run build)
// The app's files come from ./dist; only /api/* runs the Worker (sync, passphrase, DM feed).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solmourn",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CAMPAIGN", "class_name": "CampaignStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CampaignStore"] }],
  "observability": { "enabled": true }
}
